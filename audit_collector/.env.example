# Guardian Audit Collector — configuration
# Copy to .env and adjust. All variables are optional; sensible PoC
# defaults are used when unset (see collector/config.py).

# Path to the raw Kubernetes audit log. If unset, the collector will try
# to auto-discover it (running kube-apiserver process, then the static
# manifest). Leave unset on a control-plane host; set explicitly when
# running inside the Guardian container with the log directory mounted.
AUDIT_LOG_PATH=

# Final machine-readable Guardian output. Also doubles as the persisted
# aggregate store (loaded back on every restart so history is never lost).
OUTPUT_PATH=/data/guardian_audit.json

# Scanner offset/state file — tracks how far into the raw log we've read.
# Distinct from OUTPUT_PATH; do not point these at the same file.
STATE_PATH=/data/.audit_scan_state.json

# Debug log for malformed audit-log lines (never contains raw request/
# response bodies from valid events — only parse errors).
ERROR_LOG_PATH=/data/guardian_collector_errors.log

# "*" analyzes every namespace (recommended default — do not silently
# restrict to "default"). Set to a specific namespace to scope collection.
TARGET_NAMESPACE=*

# How often (seconds) the continuous polling loop rescans the log.
SCAN_INTERVAL_SECONDS=30
